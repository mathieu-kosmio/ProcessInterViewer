# Cle API OpenAI (cote serveur uniquement - jamais exposee au navigateur)
OPENAI_API_KEY=sk-...

# Port du serveur local
PORT=3000

# Modele Realtime (voix). GA actuel : gpt-realtime.
# Variante recente possible : gpt-realtime-2 (selon la doc OpenAI 2026).
REALTIME_MODEL=gpt-realtime

# Voix de l'intervieweur : marin, cedar, alloy, shimmer, echo...
REALTIME_VOICE=marin

# Modele texte utilise pour generer le dossier final (fiches + BPMN)
DOSSIER_MODEL=gpt-4o
